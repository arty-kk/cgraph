}

export function NodePanel({
  activeProject,
  selectedPath,
  selectedInGraph,
  graphTruncated,
  onLoadFullGraph,
  nodeBusy,
  nodeInfo,
  contract,
  busy,
  mode,
  depth,
  depMode,
  applyPatch,
  prompt,
  setMode,
  setDepth,
  setDepMode,
  setApplyPatch,
  setPrompt,
  canRun,
